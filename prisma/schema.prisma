// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id                     String          @id @default(cuid())
  token                  String          @unique
  name                   String
  email                  String?
  phone                  String?
  currentStage           Int             @default(0)
  note                   String?
  appointmentAt          DateTime?
  preferredNeighborhoods String[]        @default([])
  isPCS                  Boolean         @default(false)
  tourStops              Json?
  tourSavedAt            DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  stageUpdatedAt         DateTime        @default(now())
  documents              Document[]
  activityLog            ActivityLog[]
  checklistItems         ChecklistItem[]
  signatureRequests      SignatureRequest[]
}

model Document {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  filename        String
  blobUrl         String
  pathname        String
  contentType     String?
  size            Int
  visibleToClient Boolean  @default(false)
  uploadedBy      String   @default("admin")
  stageIndex      Int?
  createdAt       DateTime @default(now())

  signatureRequest SignatureRequest?

  @@index([clientId])
}

model SignatureRequest {
  id               String           @id @default(cuid())
  documentId       String           @unique
  document         Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status           String           @default("pending") // pending | viewed | signed
  fields           SignatureField[]
  viewedAt         DateTime?
  signedAt         DateTime?
  signedByName     String?
  signedIp         String?
  signedDocumentId String?
  createdAt        DateTime         @default(now())

  @@index([clientId])
}

model SignatureField {
  id        String           @id @default(cuid())
  requestId String
  request   SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type      String // signature | initials | date | text | checkbox
  page      Int
  xPct      Float
  yPct      Float
  widthPct  Float
  heightPct Float
  label     String?
  value     String?
  sortOrder Int

  @@index([requestId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())

  @@index([clientId])
}

model ChecklistItem {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stageIndex Int
  key        String
  label      String
  sortOrder  Int
  status     String    @default("pending")
  statusAt   DateTime?
  createdAt  DateTime  @default(now())

  @@unique([clientId, key])
  @@index([clientId])
}
