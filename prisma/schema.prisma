// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id             String        @id @default(cuid())
  token          String        @unique
  name           String
  email          String?
  phone          String?
  currentStage   Int           @default(0)
  note           String?
  appointmentAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  stageUpdatedAt DateTime      @default(now())
  documents      Document[]
  activityLog    ActivityLog[]
}

model Document {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  filename        String
  blobUrl         String
  pathname        String
  contentType     String?
  size            Int
  visibleToClient Boolean  @default(false)
  uploadedBy      String   @default("admin")
  createdAt       DateTime @default(now())

  @@index([clientId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())

  @@index([clientId])
}
