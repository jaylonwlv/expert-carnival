DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Vercel Blob store token (Storage tab -> Create Database -> Blob). Needed for
# per-client document uploads.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Shared password Paulin/media use to log into /admin. Change this before deploying.
ADMIN_PASSWORD="changeme"

# Shown on the client-facing tracker page contact card.
NEXT_PUBLIC_COMPANY_NAME="Relocation Engine"
NEXT_PUBLIC_AGENT_NAME="Paulin"
NEXT_PUBLIC_AGENT_PHONE="+17025550100"

# Resend (resend.com) — sends the lead-magnet guide email, the new-lead
# notification, and every checklist-milestone email (src/lib/emailTriggers.ts).
# Without RESEND_API_KEY set, lib/email.ts just console-logs "would send" and
# nothing breaks — fine for local dev, not for production. EMAIL_FROM must be
# an address on a domain verified in the Resend dashboard, or sends will fail.
RESEND_API_KEY=""
EMAIL_FROM="Relocation Engine <guide@relocationengine.com>"

# Where new-lead-submitted notifications go. Defaults to BUSINESS.email
# (src/lib/business.ts) if unset.
LEAD_NOTIFICATION_EMAIL=""

# Twilio (twilio.com) — sends the lead-submitted SMS confirmation (only to
# visitors who checked the SMS-consent box). Same "would send" console-log
# fallback as email if unset. TWILIO_FROM_NUMBER is the Twilio number itself,
# in +1XXXXXXXXXX format.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Optional: notifies this address (via Resend) when a client signs a document.
# Leave unset to skip this notification entirely.
AGENT_EMAIL=""
